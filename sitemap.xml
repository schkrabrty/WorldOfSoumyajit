---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign public_pages = site.html_pages | where_exp: 'entry', 'entry.sitemap != false' | sort: 'url' %}
{% for entry in public_pages %}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
    <priority>{{ entry.sitemap_priority | default: 0.8 }}</priority>
  </url>
{% endfor %}
</urlset>
